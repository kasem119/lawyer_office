NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ========= Production domain (required when NODE_ENV=production) =========
# Set this to your real domain with https, e.g.: https://office.myfirm.com
# This is used for CORS and PWA manifest.
ALLOWED_ORIGIN=

# Generate long, unique values and keep private
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Optional paths
# DB_PATH=
# UPLOADS_DIR=
# BACKUPS_DIR=
# CLOUD_BACKUP_DIR=
# SEED_DEMO_DATA=false

# Optional Web Push identity. When omitted, a stable key pair is stored in SQLite.
# Preserve the database (including push_config) across server updates.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Set a real contact address or your HTTPS website for push-provider support.
# VAPID_SUBJECT=mailto:admin@your-domain.com

# Optional OpenAI-compatible LLM for the legal assistant
# Directory of free providers: https://github.com/open-free-llm-api/awesome-freellm-apis
# Groq (no credit card): create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
